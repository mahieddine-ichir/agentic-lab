# AWS credentials (alternatively, use ~/.aws/credentials or IAM role)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=eu-west-1

# Claude model on Bedrock — use the cross-region inference prefix matching your region:
# Direct model IDs (no cross-region inference, eu-west-1):
#   anthropic.claude-3-haiku-20240307-v1:0       (most available, no validation)
#   anthropic.claude-3-5-haiku-20241022-v1:0     (newer haiku, no validation)
# Cross-region inference (requires eu.* profile to be enabled in account):
#   eu.anthropic.claude-3-5-sonnet-20241022-v2:0 (requires customer validation)
#   eu.anthropic.claude-3-7-sonnet-20250219-v1:0 (requires customer validation)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

PORT=8080
